[Unit]
Description=ScanSnap S1500 event daemon
Documentation=https://github.com/mmacpherson/s1500d
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/s1500d -c /etc/s1500d/config.toml
User=s1500d
Group=s1500d
StateDirectory=s1500d
StateDirectoryMode=0750
Environment=SCAN_DIR=/var/lib/s1500d/scans
Restart=always
RestartSec=5

# Hardening — handlers can write to StateDirectory, but not users' homes.
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
